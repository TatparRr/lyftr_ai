# Provider keys are comma-separated; never commit real credentials.
LLM_API_KEYS=replace-with-provider-key-1,replace-with-provider-key-2
LLM_MODEL=gemini/gemini-3.5-flash-lite

# SQLite must use the /data mount when running with Docker Compose.
DATABASE_URL=sqlite:////data/app.db
ALLOWED_ORIGINS=http://localhost:3000
ENABLE_FAILURE_SIMULATION=true
DEFAULT_SYSTEM_PROMPT=You are a helpful assistant.

# Frontend build-time variable. For Vercel, use the deployed backend URL instead.
VITE_API_BASE_URL=http://localhost:8000
